rules_version = '2';

/**
 * Firebase Storage rules for ZaikaHub.
 *
 * Images are namespaced as `images/{folder}/{ownerId}/{file}` — the `ownerId`
 * segment is what the rules authorise against, so one user can never overwrite
 * another user's uploads even if they guess the filename.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUnder(limitBytes) {
      return request.resource.size < limitBytes
        && request.resource.contentType.matches('image/.*');
    }

    // Restaurant covers, dish photos and avatars.
    match /images/{folder}/{ownerId}/{fileName} {
      // Public: restaurant and menu images must render for signed-out visitors.
      allow read: if true;

      // Writes are scoped to the owner segment of the path.
      allow write: if isSignedIn()
        && request.auth.uid == ownerId
        && isImageUnder(5 * 1024 * 1024);
    }

    /**
     * The migrated photo catalogue: every openly-licensed image the site
     * ships (covers, dishes, cuisines, showcase, link preview).
     *
     * Public to read for the same reason as the owner uploads above. Writes
     * are locked in the steady state — catalogue additions go through a
     * temporary widen-upload-tighten pass, the same dance `highlightDishes`
     * uses, because an always-open catalogue path on a billed plan is an
     * invitation to store someone else's files on our invoice.
     */
    match /images/catalog/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else outright.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
