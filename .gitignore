# ---------------------------------------------------------------------------
# ZaikaHub — .gitignore
#
# Two rules of thumb used here:
#   1. Anything reproducible from source is ignored (build output, caches,
#      downloaded assets). `npm ci` must be able to rebuild the working tree.
#   2. Anything that ISN'T reproducible and IS legally or financially relevant
#      is committed (Firestore rules, image attribution, the sitemap generator's
#      source).
# ---------------------------------------------------------------------------

# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Build output -----------------------------------------------------------
# Regenerated by `npm run build`; `dist/` is what gets deployed, not what gets
# reviewed.
dist/
.angular/
out-tsc/
*.tsbuildinfo

# --- Test / coverage artefacts ---------------------------------------------
coverage/
.nyc_output/

# --- Caches -----------------------------------------------------------------
.vite/
.cache/

# Playwright CLI writes session state, page snapshots and screenshots here.
# Snapshots are large, machine-specific and regenerated on every run.
.playwright-cli/

# --- Firebase ---------------------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log
*-debug.log

# `firebase.json`, `.firebaserc`, `firestore.rules`, `firestore.indexes.json`
# and `storage.rules` are all COMMITTED. They are the deployable contract and
# the security boundary of the backend — a repo without them cannot be
# redeployed, and a repo with an outdated copy of them is dangerous.

# Service account keys. Nothing in this project needs one, and one appearing in
# a commit is not something a `.gitignore` entry can undo — it would have to be
# rotated.
service-account*.json
*-service-account*.json
firebase-adminsdk*.json
.gcloud/
.gcloudignore.bak

# --- Environment overrides --------------------------------------------------
# `src/environments/environment.ts` and `environment.production.ts` ARE
# committed, and that is deliberate.
#
# The Firebase web API key and the Cloudinary cloud name + API key are NOT
# secrets in the conventional sense: a Firebase web app sends its API key to
# every visitor's browser, and an unsigned Cloudinary upload sends the cloud
# name and key in the request. Firebase's security comes from Firestore rules,
# not from hiding the key; Cloudinary's comes from the upload preset whitelist,
# not from hiding its key. The value that WOULD be a secret — the Cloudinary
# API secret — is not present anywhere in this repository, by design.
#
# What is ignored here is only a developer's own local override file, which is
# what `environment.local.ts` is for. It is not imported by the app; it exists
# so a machine can hold credentials without them touching the repo.
src/environments/*.local.ts
src/environments/*.local.d.ts
.env
.env.*
!.env.example

# --- Downloaded assets ------------------------------------------------------
# `tools/food-images/` holds openly-licensed photographs fetched from Wikimedia
# Commons by `node tools/fetch-food-images.mjs`. They are ~7 MB of binaries that
# can be re-fetched at any time, and committing them would bloat every clone for
# no review benefit.
#
# `credits.json` and `CREDITS.md` are the exception and ARE committed: the CC BY
# attribution is a legal obligation, so the record of who made each photo and
# under what licence must live in version control.
tools/food-images/*.jpg
tools/food-images/*.jpeg
tools/food-images/*.png
tools/food-images/*.webp
tools/food-images/search-cache.json
tools/food-images/.migrate-cache/

# --- Editors ---------------------------------------------------------------
.idea/
# Editor settings are personal; the shared task/launch definitions are not.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
*.swp
*.swo

# --- OS --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs ------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- Temporary / misc -------------------------------------------------------
temp/
tmp/
*.tmp
*.bak
*.orig
*.rej
.merge_backup/